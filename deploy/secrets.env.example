# sns-myagent secrets template
# Copy to /etc/snsagent/secrets.env and fill in, then chmod 600
# Loaded by systemd snsagent.service via EnvironmentFile=

# Telegram bot token (from @BotFather)
# SNS_TELEGRAM_BOT_TOKEN=

# Telegram chat ID where /start is sent (for notifications)
# SNS_TELEGRAM_CHAT_ID=
