---
import { MobileNav } from "./react/MobileNav";
import { ThemeToggle } from "./react/ThemeToggle";

interface Props {
  active?: "home" | "docs";
}

const { active } = Astro.props;

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#screenshots", label: "Screenshots" },
  { href: "/docs/", label: "Docs" },
  { href: "https://github.com/Reihantt6/sns-myagent", label: "GitHub" },
];
---

<header class="sticky top-0 z-30 border-b border-[var(--color-line)] bg-[var(--color-ink)]/85 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex min-h-[44px] items-center gap-2.5 text-[15px] font-bold tracking-tight" aria-label="SNS-MyAgent home">
      <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-[var(--color-accent-border)] bg-[var(--color-accent-muted)] font-mono text-[13px] font-bold text-[var(--color-accent)]">&gt;_</span>
      <span>SNS-MyAgent</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "flex min-h-[44px] items-center rounded-[10px] px-3.5 py-2 text-[14px] font-medium text-[var(--color-fg-2)] transition-colors duration-150 hover:bg-[var(--color-surface)] hover:text-[var(--color-fg)]",
              link.href.startsWith("/#") && active === "home" ? "text-[var(--color-fg)]" : "",
              link.href === "/docs/" && active === "docs" ? "text-[var(--color-fg)]" : "",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <ThemeToggle client:load />
      <a href="/docs/installation/" class="btn btn-primary hidden !min-h-[44px] !px-4 !py-2 !text-[13.5px] sm:inline-flex">
        Install snsagent
      </a>
      <MobileNav client:load links={links} />
    </div>
  </div>
</header>
