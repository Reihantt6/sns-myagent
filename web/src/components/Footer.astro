---
const docGroups = [
  {
    title: "Getting started",
    links: [
      { href: "/docs/installation/", label: "Installation" },
      { href: "/docs/configuration/", label: "Configuration" },
      { href: "/docs/faq/", label: "FAQ" },
      { href: "/docs/troubleshooting/", label: "Troubleshooting" },
    ],
  },
  {
    title: "Core",
    links: [
      { href: "/docs/terminal-ui/", label: "Terminal UI" },
      { href: "/docs/memory/", label: "Memory" },
      { href: "/docs/architecture/", label: "Architecture" },
      { href: "/docs/security-model/", label: "Security model" },
    ],
  },
  {
    title: "Integrations",
    links: [
      { href: "/docs/mcp/", label: "MCP" },
      { href: "/docs/telegram/", label: "Telegram" },
      { href: "/docs/browser/", label: "Browser" },
      { href: "/docs/cron/", label: "Cron" },
    ],
  },
];
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-ink-2)]">
  <div class="container-site py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex min-h-[44px] items-center gap-2.5 text-[15px] font-bold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-[var(--color-accent-border)] bg-[var(--color-accent-muted)] font-mono text-[13px] font-bold text-[var(--color-accent)]">&gt;_</span>
          SNS-MyAgent
        </a>
        <p class="mt-4 max-w-[30ch] text-[14px] leading-relaxed text-[var(--color-fg-3)]">
          A single-user AI coding agent for the terminal. Bring your own key, configure it by talking to it.
        </p>
        <a
          href="https://github.com/Reihantt6/sns-myagent"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-[44px] items-center gap-2 rounded-[10px] border border-[var(--color-line-2)] px-4 text-[13.5px] font-semibold text-[var(--color-fg-2)] transition-colors hover:border-[var(--color-accent-border)] hover:text-[var(--color-accent)]"
        >
          GitHub repository
        </a>
      </div>

      {
        docGroups.map((group) => (
          <nav aria-label={group.title}>
            <h3 class="text-[12px] font-bold uppercase tracking-[0.12em] text-[var(--color-fg-3)]">{group.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {
                group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex min-h-[44px] items-center text-[14px] text-[var(--color-fg-2)] transition-colors hover:text-[var(--color-accent)]"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-[var(--color-line)] pt-6 text-[13px] text-[var(--color-fg-3)] sm:flex-row sm:items-center sm:justify-between">
      <p>MIT License · v0.3.9 · BYOK, no forced subscription</p>
      <p class="font-mono">&gt;_ snsagent</p>
    </div>
  </div>
</footer>
