---
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { DOCS_GROUPS } from "../../../data/docs-nav";
import { getCollection } from "astro:content";
import { ArrowRightIcon } from "@phosphor-icons/react";

const docs = await getCollection("docs");
const idDocs = docs.filter((d) => d.id.startsWith("id/"));
const titles = new Map(idDocs.map((d) => [d.id.replace(/^id\//, "").replace(/\.md$/, ""), d.data.title]));
const displayName = (slug: string) => titles.get(slug) ?? slug.replace(/-/g, " ");
---

<Base title="Dokumentasi" description="Dokumentasi dan panduan SNS-MyAgent" canonical="/docs/id/">
  <Nav active="docs" />
  <main class="container-site pb-28 pt-16 md:pt-24">
    <header class="max-w-[640px]">
      <p class="eyebrow mb-4">Dokumentasi</p>
      <h1 class="text-[34px] font-extrabold tracking-tight text-[var(--color-fg)] md:text-[44px]">
        Semua yang Anda butuhkan untuk menjalankannya
      </h1>
      <p class="mt-5 text-[16.5px] leading-relaxed text-[var(--color-fg-2)]">
        Panduan pemasangan, referensi fitur, dan dokumentasi operasional untuk SNS-MyAgent:
        agen AI self-hosted dan privat yang berjalan sepenuhnya di mesin Anda sendiri.
      </p>
      <a href="/docs/" class="mt-4 inline-flex min-h-[44px] items-center gap-2 rounded-[10px] text-[14px] font-semibold text-[var(--color-accent)]">
        Read in English
        <ArrowRightIcon size={16} />
      </a>
    </header>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {DOCS_GROUPS.map((group) => (
        <section class="rounded-[16px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6">
          <h2 class="text-[13px] font-bold uppercase tracking-[0.12em] text-[var(--color-fg-3)]">
            {group.labelId}
          </h2>
          <ul class="mt-4 divide-y divide-[var(--color-line)]">
            {group.slugs.map((slug) => (
              <li>
                <a
                  href={`/docs/id/${slug}/`}
                  class="group flex min-h-[44px] items-center justify-between gap-3 py-2.5"
                >
                  <span class="text-[14.5px] font-medium text-[var(--color-fg-2)] transition-colors group-hover:text-[var(--color-accent)]">
                    {displayName(slug)}
                  </span>
                  <ArrowRightIcon
                    size={15}
                    className="shrink-0 text-[var(--color-fg-3)] transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-[var(--color-accent)]"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Base>
