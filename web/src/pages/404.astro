---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="404 — Page not found" description="Page not found" canonical="/404/">
  <Nav />
  <main class="container notfound">
    <p class="nf-code">404</p>
    <h1>Page not found</h1>
    <p class="nf-text">
      The page you are looking for doesn't exist or has moved.
    </p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/docs/" class="btn btn-ghost">Browse docs</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    min-height: calc(100vh - 62px - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 64px 24px;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 72px;
    font-weight: 700;
    color: var(--green);
    margin: 0 0 8px;
  }
  .notfound h1 {
    font-size: 28px;
    margin: 0 0 12px;
  }
  .nf-text {
    color: var(--text-2);
    margin: 0 0 32px;
  }
  .nf-actions {
    display: flex;
    gap: 12px;
  }
</style>