---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="404 · Page not found" description="Page not found" canonical="/404/">
  <Nav />
  <main class="flex min-h-[calc(100vh-64px-340px)] items-center justify-center px-6 py-20">
    <div class="text-center">
      <p class="font-mono text-[64px] font-bold leading-none text-[var(--color-accent)] md:text-[84px]">
        404
      </p>
      <h1 class="mt-4 text-[24px] font-bold tracking-tight text-[var(--color-fg)] md:text-[28px]">
        Page not found
      </h1>
      <p class="mx-auto mt-3 max-w-[40ch] text-[15.5px] leading-relaxed text-[var(--color-fg-2)]">
        The page you are looking for does not exist or has moved.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/docs/" class="btn btn-ghost">Browse docs</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
